# ── Base de datos ─────────────────────────────────────────────
DATABASE_URL="postgresql://wispx:wispx@localhost:5434/wispx_clone"

# ── Autenticación ─────────────────────────────────────────────
# URL pública de la app (en producción, el dominio con https).
NEXTAUTH_URL="http://localhost:3010"
# Mínimo 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""

# ── Cifrado de credenciales de equipos (routers, OLT, WhatsApp) ─
# 32 bytes en base64, mismo comando que arriba. NO cambiarla después de guardar
# equipos: los datos cifrados con la clave anterior dejarían de poder leerse.
ENCRYPTION_KEY=""

# ── Alta inicial (npm run setup) ──────────────────────────────
SETUP_COMPANY_NAME="Mi ISP"
SETUP_ADMIN_NAME="Administrador"
SETUP_ADMIN_EMAIL="admin@miisp.com"
# Mínimo 10 caracteres. Puedes borrarla del .env después de ejecutar el setup.
SETUP_ADMIN_PASSWORD=""

# ── Valores por defecto de la empresa ─────────────────────────
DEFAULT_COUNTRY="EC"
DEFAULT_CURRENCY="USD"
DEFAULT_TIMEZONE="America/Guayaquil"

# ── Monitoreo MikroTik ────────────────────────────────────────
# Con varias instancias de la app, pon "false" en todas menos una.
MONITORING_ENABLED="true"

# ── Facturación por zonas y cortes automáticos ───────────────
# Con varias instancias, pon "false" en todas menos una (además hay un bloqueo en la base).
JOBS_ENABLED="true"
