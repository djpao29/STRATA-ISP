// Esquema de WISPX Clone. Los cambios se aplican con migraciones:
//   desarrollo:  npm run db:migrate      (crea una migración nueva)
//   producción:  npm run db:deploy       (aplica las migraciones pendientes)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  TECHNICIAN
  BILLING
}

enum CustomerStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
  PENDING
}

enum InvoiceStatus {
  PENDING
  OVERDUE
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  DEPOSIT
  OTHER
}

enum RouterStatus {
  ONLINE
  OFFLINE
  UNKNOWN
  DEGRADED // responde, pero con alertas activas
}

enum InterfaceRole {
  WAN
  LAN
  OTHER
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  ACTIVE
  RESOLVED
}

enum RouterType {
  MIKROTIK
  CISCO
  JUNIPER
  GENERIC
}

enum ClientMode {
  DHCP
  STATIC_IP
  PPPoE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum OLTStatus {
  ONLINE
  OFFLINE
  UNKNOWN
}

enum ONUStatus {
  /// En línea.
  ACTIVE
  /// Desactivada a propósito.
  INACTIVE
  /// Fuera de línea por pérdida de señal óptica (fibra).
  LOS
  /// Sin energía (dying gasp: el cliente apagó o se fue la luz).
  POWER_OFF
  /// Fuera de línea por otra causa.
  OFFLINE
  /// Aún no leída de la OLT.
  UNKNOWN
}

enum OltBrand {
  HUAWEI
  ZTE
  VSOL
  HIOSO
  CDATA
  BDCOM
}

/// Tecnología PON de la OLT: GPON identifica ONUs por serial; EPON por MAC.
enum PonType {
  GPON
  EPON
  GPON_EPON
}

enum CliProtocol {
  TELNET
  SSH
}

enum OnuAuthState {
  /// Autorizada en la OLT.
  AUTHORIZED
  /// Registrada en el sistema; se autoriza sola cuando la OLT la detecte.
  PREAUTHORIZED
  /// En cola para autorizar (o reintentando).
  PENDING
  /// La OLT rechazó la autorización.
  FAILED
}

enum PonEventKind {
  SIGNAL_VARIATION
  POWER_OFF
  LOS
  PON_DOWN
  OFFLINE
}

model Tenant {
  id                 String   @id @default(cuid())
  name               String
  country            String   @default("EC")
  currency           String   @default("USD")
  timezone           String   @default("America/Guayaquil")
  taxId              String?
  address            String?
  phone              String?
  email              String?
  isActive           Boolean  @default(true)
  // Facturación
  invoicePrefix      String   @default("F")
  nextInvoiceNumber  Int      @default(1)
  nextCustomerCode   Int      @default(1)
  nextProformaNumber Int      @default(1)
  dueDays            Int      @default(10)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users     User[]
  customers Customer[]
  plans     Plan[]
  services  Service[]
  invoices  Invoice[]
  payments  Payment[]
  routers   Router[]
  olts      OLT[]
  tickets   Ticket[]
  whatsapp  WhatsAppConfig?
  auditLogs AuditLog[]

  monitoringSettings    MonitoringSettings?
  zones                 Zone[]
  networkActions        NetworkAction[]
  jobRuns               JobRun[]
  paymentAccounts       PaymentAccount[]
  paymentPromises       PaymentPromise[]
  proformas             Proforma[]
  expenses              Expense[]
  expenseCategories     ExpenseCategory[]
  installations         Installation[]
  customerDevices       CustomerDevice[]
  notificationCampaigns NotificationCampaign[]
  screenNotices         ScreenNotice[]
  monitorAlerts         MonitorAlert[]
  onuModels             OnuModel[]
  oltSpeedPlans         OltSpeedPlan[]
  napBoxes              NapBox[]
  ponEvents             PonEvent[]
  oltSettings           OltSettings?

  @@map("tenants")
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  password    String
  name        String
  role        UserRole
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  tenantId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant                Tenant                 @relation(fields: [tenantId], references: [id])
  assignedTickets       Ticket[]
  ticketComments        TicketComment[]
  payments              Payment[]
  auditLogs             AuditLog[]
  paymentPromises       PaymentPromise[]
  expenses              Expense[]
  reviewedPayments      Payment[]              @relation("PaymentReviewer")
  installationsAssigned Installation[]         @relation("InstallationTechnician")
  installationsCreated  Installation[]         @relation("InstallationCreator")
  notificationCampaigns NotificationCampaign[]
  screenNotices         ScreenNotice[]
  noticeDismissals      NoticeDismissal[]

  @@index([tenantId])
  @@map("users")
}

model Customer {
  id               String         @id @default(cuid())
  /// Opcional: hay clientes sin cédula registrada.
  cedula           String?
  firstName        String
  lastName         String
  email            String?
  email2           String?
  phone            String
  /// Teléfono secundario (también sirve para WhatsApp).
  phone2           String?
  address          String?
  province         String?
  city             String?
  neighborhood     String?
  coordinates      String? // "lat,lng"
  notes            String?
  status           CustomerStatus @default(PENDING)
  /// Código correlativo por empresa (C-000001).
  code             Int?
  zoneId           String?
  /// Nunca cortar automáticamente a este cliente.
  suspendExempt    Boolean        @default(false)
  /// Origen de la suspensión actual: "AUTO" (por falta de pago) o "MANUAL".
  suspensionSource String?
  suspendedAt      DateTime?
  reconnectedAt    DateTime?
  tenantId         String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  services               Service[]
  invoices               Invoice[]
  payments               Payment[]
  tickets                Ticket[]
  zone                   Zone?                   @relation(fields: [zoneId], references: [id])
  onus                   ONU[]
  networkActions         NetworkAction[]
  paymentPromises        PaymentPromise[]
  proformas              Proforma[]
  installations          Installation[]
  devices                CustomerDevice[]
  notificationRecipients NotificationRecipient[]

  @@unique([tenantId, cedula])
  @@unique([tenantId, code])
  @@index([zoneId])
  @@index([tenantId, status])
  @@map("customers")
}

model Plan {
  id           String       @id @default(cuid())
  name         String
  description  String?
  download     Int // Mbps
  upload       Int // Mbps
  price        Decimal      @db.Decimal(10, 2)
  /// Cómo se controla la velocidad en el MikroTik: cola simple por IP o perfil PPP.
  kind         PlanKind     @default(SIMPLE_QUEUE)
  category     PlanCategory @default(RESIDENTIAL)
  /// Simple Queue: "límite umbral tiempo" en el orden de MikroTik (subida/bajada), ej. "20M/5M 15M/4M 10".
  burst        String?
  /// Simple Queue: prioridad 1 (más alta) a 8.
  priorityUp   Int          @default(8)
  priorityDown Int          @default(8)
  /// PPPoE: nombre del perfil en /ppp/profile.
  pppProfile   String?
  isActive     Boolean      @default(true)
  tenantId     String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  services Service[]

  @@unique([tenantId, name])
  @@index([tenantId, kind])
  @@map("plans")
}

enum AccessType {
  FIBER
  ANTENNA
}

enum PlanKind {
  SIMPLE_QUEUE
  PPPOE
}

enum PlanCategory {
  RESIDENTIAL
  CORPORATE
}

/// Un servicio es un plan contratado por un cliente, opcionalmente asociado a un router.
model Service {
  id               String       @id @default(cuid())
  customerId       String
  planId           String
  routerId         String?
  mode             ClientMode   @default(PPPoE)
  ipAddress        String?
  macAddress       String?
  pppoeUser        String?
  /// Clave PPPoE cifrada con ENCRYPTION_KEY (para crear el usuario en el MikroTik).
  pppoePasswordEnc String?
  ipv6             String?
  /// Interfaz LAN del router por donde llega el cliente (referencia).
  lanInterface     String?
  /// WAN preferida para este cliente (referencia; vacío = automática).
  wanInterface     String?
  /// Descuento fijo mensual sobre el precio del plan.
  discount         Decimal      @default(0) @db.Decimal(10, 2)
  discountNote     String?
  accessType       AccessType?
  /// Antena: AP / sector al que se conecta.
  accessPoint      String?
  /// true = se configura también en el MikroTik; false = solo en el panel.
  syncRouter       Boolean      @default(true)
  isActive         Boolean      @default(true)
  installedAt      DateTime     @default(now())
  /// Estado aplicado en el router (lo último que hizo el sistema).
  networkState     NetworkState @default(ACTIVE)
  networkStateAt   DateTime?
  tenantId         String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan           Plan             @relation(fields: [planId], references: [id])
  router         Router?          @relation(fields: [routerId], references: [id], onDelete: SetNull)
  invoices       Invoice[]
  networkActions NetworkAction[]
  devices        CustomerDevice[]

  @@index([tenantId])
  @@index([customerId])
  @@map("services")
}

model Invoice {
  id          String        @id @default(cuid())
  number      String
  description String
  amount      Decimal       @db.Decimal(10, 2)
  status      InvoiceStatus @default(PENDING)
  periodStart DateTime?
  /// Fin del periodo facturado (exclusivo): inicio del siguiente ciclo.
  periodEnd   DateTime?
  /// Si sigue impaga a partir de esta fecha, se corta el servicio (null = no genera corte).
  suspendDate DateTime?
  zoneId      String?
  issueDate   DateTime      @default(now())
  dueDate     DateTime
  paidDate    DateTime?
  customerId  String
  serviceId   String?
  tenantId    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  customer        Customer         @relation(fields: [customerId], references: [id])
  service         Service?         @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  zone            Zone?            @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  payments        Payment[]
  paymentPromises PaymentPromise[]
  proforma        Proforma?

  @@unique([tenantId, number])
  // Evita facturar dos veces el mismo servicio en el mismo periodo.
  @@unique([serviceId, periodStart])
  @@index([tenantId, status])
  @@index([customerId])
  @@map("invoices")
}

model Payment {
  id           String        @id @default(cuid())
  amount       Decimal       @db.Decimal(10, 2)
  method       PaymentMethod @default(CASH)
  reference    String?
  status       PaymentStatus @default(APPROVED)
  paidDate     DateTime      @default(now())
  notes        String?
  /// Forma de pago configurada (cuenta bancaria, caja...).
  accountId    String?
  /// "STAFF" (registrado en oficina) o "REPORT" (informado por el cliente, pendiente de revisión).
  source       String        @default("STAFF")
  /// Comprobante (imagen o PDF) guardado en la base de datos.
  receiptData  Bytes?
  receiptMime  String?
  receiptName  String?
  reviewedById String?
  reviewedAt   DateTime?
  rejectReason String?
  invoiceId    String?
  customerId   String
  createdById  String?
  tenantId     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  customer   Customer        @relation(fields: [customerId], references: [id])
  invoice    Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdBy  User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  account    PaymentAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  reviewedBy User?           @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([invoiceId])
  @@map("payments")
}

model Router {
  id                String       @id @default(cuid())
  name              String
  host              String
  /// Puerto de la API REST de RouterOS 7 (servicio www-ssl 443 o www 80).
  port              Int          @default(443)
  useHttps          Boolean      @default(true)
  /// Validar el certificado TLS (desactivar solo con certificados autofirmados en red privada).
  verifyTls         Boolean      @default(false)
  /// Address-list donde se agregan los clientes con IP estática/DHCP cortados.
  suspendList       String       @default("morosos")
  username          String
  /// Cifrada con ENCRYPTION_KEY (AES-256-GCM).
  passwordEnc       String
  type              RouterType   @default(MIKROTIK)
  status            RouterStatus @default(UNKNOWN)
  lastCheckedAt     DateTime?
  // Monitoreo
  monitoringEnabled Boolean      @default(true)
  identity          String?
  model             String?
  osVersion         String?
  lastSeenAt        DateTime?
  lastError         String?
  latencyMs         Int?
  failCount         Int          @default(0)
  tenantId          String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  services       Service[]
  metrics        RouterMetric[]
  interfaces     RouterInterface[]
  alerts         MonitorAlert[]
  networkActions NetworkAction[]

  @@unique([tenantId, name])
  @@map("routers")
}

/// Una muestra del estado del router por cada ciclo del recolector.
model RouterMetric {
  id          String   @id @default(cuid())
  routerId    String
  at          DateTime @default(now())
  latencyMs   Int
  cpuLoad     Int
  memUsed     BigInt
  memTotal    BigInt
  hddUsed     BigInt
  hddTotal    BigInt
  temperature Float?
  voltage     Float?
  uptimeSec   Int
  pppActive   Int?
  wanRxBps    BigInt?
  wanTxBps    BigInt?

  router Router @relation(fields: [routerId], references: [id], onDelete: Cascade)

  @@index([routerId, at])
  @@map("router_metrics")
}

/// Estado actual de cada interfaz del router y su configuración en el sistema.
model RouterInterface {
  id          String        @id @default(cuid())
  routerId    String
  name        String
  type        String
  comment     String?
  role        InterfaceRole @default(OTHER)
  isSfp       Boolean       @default(false)
  /// Guardar historial de tráfico de esta interfaz.
  monitored   Boolean       @default(false)
  /// Generar alerta si la interfaz se cae.
  alertOnDown Boolean       @default(false)
  running     Boolean       @default(false)
  disabled    Boolean       @default(false)
  rxBytes     BigInt        @default(0)
  txBytes     BigInt        @default(0)
  rxBps       BigInt        @default(0)
  txBps       BigInt        @default(0)
  sampledAt   DateTime?
  missing     Boolean       @default(false)

  router  Router            @relation(fields: [routerId], references: [id], onDelete: Cascade)
  samples InterfaceSample[]

  @@unique([routerId, name])
  @@map("router_interfaces")
}

model InterfaceSample {
  id          String   @id @default(cuid())
  interfaceId String
  at          DateTime @default(now())
  rxBps       BigInt
  txBps       BigInt

  interface RouterInterface @relation(fields: [interfaceId], references: [id], onDelete: Cascade)

  @@index([interfaceId, at])
  @@map("interface_samples")
}

/// Umbrales e intervalos de monitoreo por empresa.
model MonitoringSettings {
  tenantId          String   @id
  pollIntervalSec   Int      @default(60)
  liveRefreshSec    Int      @default(5)
  requestTimeoutSec Int      @default(8)
  cpuThreshold      Int      @default(85)
  memThreshold      Int      @default(90)
  tempThreshold     Int      @default(70)
  latencyThreshold  Int      @default(1500)
  /// Fallos seguidos antes de marcar el router como desconectado.
  offlineAfterFails Int      @default(2)
  retentionDays     Int      @default(7)
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("monitoring_settings")
}

model MonitorAlert {
  id         String        @id @default(cuid())
  tenantId   String
  routerId   String
  /// Tipo + objeto, p. ej. "cpu", "offline", "iface_down:sfp-sfpplus1". Solo una alerta activa por clave.
  key        String
  severity   AlertSeverity
  status     AlertStatus   @default(ACTIVE)
  message    String
  value      String?
  startedAt  DateTime      @default(now())
  resolvedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  router Router @relation(fields: [routerId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([routerId, key, status])
  @@map("monitor_alerts")
}

model Ticket {
  id          String       @id @default(cuid())
  title       String
  description String
  status      TicketStatus @default(OPEN)
  priority    Priority     @default(MEDIUM)
  customerId  String
  assignedTo  String?
  closedAt    DateTime?
  tenantId    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  customer Customer        @relation(fields: [customerId], references: [id])
  assigned User?           @relation(fields: [assignedTo], references: [id], onDelete: SetNull)
  comments TicketComment[]

  @@index([tenantId, status])
  @@map("tickets")
}

model TicketComment {
  id        String   @id @default(cuid())
  message   String
  ticketId  String
  userId    String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@map("ticket_comments")
}

model OLT {
  id                String      @id @default(cuid())
  name              String
  host              String
  port              Int         @default(161)
  vendor            String?
  /// Comunidad SNMP cifrada con ENCRYPTION_KEY.
  communityEnc      String
  status            OLTStatus   @default(UNKNOWN)
  brand             OltBrand    @default(HUAWEI)
  /// Acceso de consola para autorizar ONUs (Telnet o SSH).
  cliProtocol       CliProtocol @default(TELNET)
  cliPort           Int         @default(23)
  cliUsername       String?
  /// Cifrada con ENCRYPTION_KEY.
  cliPasswordEnc    String?
  /// Clave de "enable" si la OLT la pide (cifrada).
  enablePasswordEnc String?
  /// Número de frame/rack (Huawei 0, ZTE 1).
  frame             Int         @default(0)
  coordinates       String?
  pollEnabled       Boolean     @default(true)
  lastPollAt        DateTime?
  lastError         String?
  temperature       Float?
  uptimeSec         Int?
  /// Perfiles por defecto para autorizar (Huawei: line/srv profile ID; ZTE: tcont/onu profile; VSOL: profile).
  lineProfile       String?
  srvProfile        String?
  defaultVlan       Int?
  /// Plantilla de comandos propia para autorizar (vacía = la de la marca).
  authTemplate      String?
  ponType           PonType     @default(GPON)
  softwareVersion   String?
  /// Comandos de consola para leer las ONUs autorizadas (vacío = los de la marca).
  readTemplate      String?
  /// Comandos de consola para leer las ONUs sin autorizar (vacío = los de la marca).
  autofindTemplate  String?
  /// "2c" (comunidad) o "3" (usuario con autenticación/cifrado).
  snmpVersion       String      @default("2c")
  snmpV3User        String?
  /// noAuthNoPriv | authNoPriv | authPriv
  snmpV3Level       String?
  /// MD5 | SHA
  snmpV3AuthProto   String?
  /// Cifradas con ENCRYPTION_KEY.
  snmpV3AuthKeyEnc  String?
  /// DES | AES
  snmpV3PrivProto   String?
  snmpV3PrivKeyEnc  String?
  /// Descripción del equipo leída por SNMP (modelo y firmware).
  sysDescr          String?
  tenantId          String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  onus        ONU[]
  discoveries OnuDiscovery[]
  napBoxes    NapBox[]
  ponEvents   PonEvent[]

  @@unique([tenantId, name])
  @@map("olts")
}

model ONU {
  id              String       @id @default(cuid())
  serial          String
  name            String?
  slot            Int
  port            Int
  onuIndex        Int?
  status          ONUStatus    @default(ACTIVE)
  authState       OnuAuthState @default(AUTHORIZED)
  authorizedAt    DateTime?
  authError       String?
  /// ¿Apareció en la última lectura de la OLT?
  inOlt           Boolean      @default(false)
  lastSeenAt      DateTime?
  statusChangedAt DateTime?
  /// Potencia óptica recibida por la ONU (dBm) y la lectura anterior.
  rxPower         Float?
  prevRxPower     Float?
  txPower         Float?
  vlan            Int?
  onuModelId      String?
  speedPlanId     String?
  napBoxId        String?
  napPort         Int?
  customerId      String?
  oltId           String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  olt       OLT           @relation(fields: [oltId], references: [id], onDelete: Cascade)
  customer  Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  onuModel  OnuModel?     @relation(fields: [onuModelId], references: [id], onDelete: SetNull)
  speedPlan OltSpeedPlan? @relation(fields: [speedPlanId], references: [id], onDelete: SetNull)
  napBox    NapBox?       @relation(fields: [napBoxId], references: [id], onDelete: SetNull)
  events    PonEvent[]

  @@unique([oltId, serial])
  @@map("onus")
}

/// Configuración de WhatsApp Cloud API (Meta) por tenant.
model WhatsAppConfig {
  id             String   @id @default(cuid())
  phoneNumberId  String
  displayPhone   String?
  /// Token de acceso cifrado con ENCRYPTION_KEY.
  accessTokenEnc String
  isActive       Boolean  @default(false)
  tenantId       String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("whatsapp_configs")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String // p. ej. "customer.create"
  entity    String
  entityId  String?
  details   Json?
  userId    String?
  tenantId  String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

enum NetworkState {
  ACTIVE
  SUSPENDED
}

enum NetworkActionType {
  SUSPEND
  RECONNECT
}

enum NetworkActionStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  CANCELLED
}

/// Zona de facturación: define el ciclo de factura, pago y corte de sus clientes.
model Zone {
  id                   String   @id @default(cuid())
  tenantId             String
  name                 String
  /// Día del mes en que se genera la factura (1-31; en meses cortos se usa el último día).
  invoiceDay           Int
  /// Día límite de pago (si es menor que el de factura, cae en el mes siguiente).
  dueDay               Int
  /// Día de corte (si es menor que el límite de pago, cae en el mes siguiente).
  suspendDay           Int
  /// Hora local (0-23) a la que se generan las facturas y se ejecutan los cortes.
  invoiceHour          Int      @default(0)
  suspendHour          Int      @default(0)
  isActive             Boolean  @default(true)
  autoInvoice          Boolean  @default(true)
  autoSuspend          Boolean  @default(true)
  autoReconnect        Boolean  @default(true)
  /// Facturar también a clientes suspendidos.
  invoiceSuspended     Boolean  @default(false)
  /// Facturas impagas con fecha de corte cumplida necesarias para cortar.
  suspendAfterInvoices Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  customers Customer[]
  invoices  Invoice[]

  @@unique([tenantId, name])
  @@map("zones")
}

/// Cola de acciones sobre el router (cortes y reconexiones) con reintentos.
model NetworkAction {
  id            String              @id @default(cuid())
  tenantId      String
  customerId    String
  serviceId     String
  routerId      String?
  type          NetworkActionType
  status        NetworkActionStatus @default(PENDING)
  /// "AUTO" o "MANUAL".
  source        String
  reason        String
  /// Método aplicado: "ppp_secret" o "address_list".
  method        String?
  attempts      Int                 @default(0)
  nextAttemptAt DateTime            @default(now())
  lastError     String?
  createdById   String?
  createdAt     DateTime            @default(now())
  finishedAt    DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  router   Router?  @relation(fields: [routerId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([tenantId, createdAt])
  @@map("network_actions")
}

/// Registro de cada ejecución de las tareas programadas.
model JobRun {
  id         String    @id @default(cuid())
  tenantId   String
  job        String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(true)
  summary    Json?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, startedAt])
  @@map("job_runs")
}

/// Bloqueo para que las tareas programadas corran en una sola instancia a la vez.
model JobLock {
  name        String   @id
  owner       String
  lockedUntil DateTime

  @@map("job_locks")
}

/// Forma de pago: caja, cuenta bancaria, pasarela... (se elige al registrar pagos y gastos).
model PaymentAccount {
  id        String        @id @default(cuid())
  tenantId  String
  name      String
  method    PaymentMethod
  /// Banco, número de cuenta, titular u otras indicaciones para el cliente.
  details   String?
  isActive  Boolean       @default(true)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  payments Payment[]
  expenses Expense[]

  @@unique([tenantId, name])
  @@map("payment_accounts")
}

enum PromiseStatus {
  ACTIVE
  FULFILLED
  BROKEN
  CANCELLED
}

/// Promesa de pago: mientras esté vigente, el cliente no se corta por falta de pago.
model PaymentPromise {
  id           String        @id @default(cuid())
  tenantId     String
  customerId   String
  invoiceId    String?
  amount       Decimal?      @db.Decimal(10, 2)
  /// Fecha límite prometida (fecha de calendario).
  promisedDate DateTime
  notes        String?
  status       PromiseStatus @default(ACTIVE)
  createdById  String?
  createdAt    DateTime      @default(now())
  resolvedAt   DateTime?

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([customerId, status])
  @@map("payment_promises")
}

enum ProformaStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  INVOICED
}

/// Proforma o cotización: documento sin valor fiscal que se puede convertir en factura.
model Proforma {
  id         String         @id @default(cuid())
  tenantId   String
  number     String
  customerId String?
  /// Para prospectos que aún no son clientes.
  clientName String?
  clientInfo String?
  issueDate  DateTime
  validUntil DateTime
  status     ProformaStatus @default(DRAFT)
  notes      String?
  total      Decimal        @db.Decimal(10, 2)
  invoiceId  String?        @unique
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  customer Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  invoice  Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  items    ProformaItem[]

  @@unique([tenantId, number])
  @@map("proformas")
}

model ProformaItem {
  id          String  @id @default(cuid())
  proformaId  String
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(10, 2)
  sortOrder   Int     @default(0)

  proforma Proforma @relation(fields: [proformaId], references: [id], onDelete: Cascade)

  @@map("proforma_items")
}

model ExpenseCategory {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  expenses Expense[]

  @@unique([tenantId, name])
  @@map("expense_categories")
}

/// Gasto de la empresa (egreso).
model Expense {
  id          String   @id @default(cuid())
  tenantId    String
  date        DateTime
  categoryId  String
  description String
  supplier    String?
  reference   String?
  amount      Decimal  @db.Decimal(10, 2)
  accountId   String?
  receiptData Bytes?
  receiptMime String?
  receiptName String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  category  ExpenseCategory @relation(fields: [categoryId], references: [id])
  account   PaymentAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, date])
  @@map("expenses")
}

enum InstallationStatus {
  SCHEDULED
  IN_PROGRESS
  DONE
  CANCELLED
}

/// Instalación programada de un cliente.
model Installation {
  id              String             @id @default(cuid())
  tenantId        String
  customerId      String
  scheduledAt     DateTime
  technicianId    String?
  status          InstallationStatus @default(SCHEDULED)
  notes           String?
  completedAt     DateTime?
  completionNotes String?
  createdById     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  technician User?    @relation("InstallationTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  createdBy  User?    @relation("InstallationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, scheduledAt])
  @@map("installations")
}

/// Router WiFi / equipo instalado en casa del cliente.
model CustomerDevice {
  id               String   @id @default(cuid())
  tenantId         String
  customerId       String
  serviceId        String?
  brand            String?
  model            String?
  serial           String?
  macAddress       String?
  managementIp     String?
  ssid             String?
  /// Clave WiFi cifrada con ENCRYPTION_KEY.
  wifiPasswordEnc  String?
  adminUser        String?
  /// Clave de administración cifrada con ENCRYPTION_KEY.
  adminPasswordEnc String?
  band             String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service  Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([customerId])
  @@map("customer_devices")
}

enum CampaignStatus {
  SENDING
  DONE
  CANCELLED
}

enum RecipientStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// Envío de mensajes de WhatsApp a uno o varios clientes.
model NotificationCampaign {
  id          String         @id @default(cuid())
  tenantId    String
  name        String
  template    String
  language    String
  /// Parámetros de la plantilla con variables: ["{nombre}", "{saldo}"]
  params      Json
  /// Filtro usado para elegir destinatarios (para el historial).
  audience    String
  status      CampaignStatus @default(SENDING)
  createdById String?
  createdAt   DateTime       @default(now())
  finishedAt  DateTime?

  tenant     Tenant                  @relation(fields: [tenantId], references: [id])
  createdBy  User?                   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  recipients NotificationRecipient[]

  @@index([tenantId, createdAt])
  @@map("notification_campaigns")
}

model NotificationRecipient {
  id         String          @id @default(cuid())
  campaignId String
  customerId String
  phone      String
  /// Parámetros ya reemplazados para este cliente.
  params     Json
  status     RecipientStatus @default(PENDING)
  messageId  String?
  error      String?
  attempts   Int             @default(0)
  sentAt     DateTime?

  campaign NotificationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@map("notification_recipients")
}

enum NoticeSeverity {
  INFO
  WARNING
  CRITICAL
}

/// Aviso que aparece en la pantalla del panel para el personal.
model ScreenNotice {
  id          String         @id @default(cuid())
  tenantId    String
  title       String
  message     String
  severity    NoticeSeverity @default(INFO)
  /// Roles que lo ven (vacío = todos).
  roles       UserRole[]
  startsAt    DateTime
  endsAt      DateTime?
  isActive    Boolean        @default(true)
  dismissible Boolean        @default(true)
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  createdBy  User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  dismissals NoticeDismissal[]

  @@index([tenantId, isActive])
  @@map("screen_notices")
}

model NoticeDismissal {
  noticeId    String
  userId      String
  dismissedAt DateTime @default(now())

  notice ScreenNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([noticeId, userId])
  @@map("notice_dismissals")
}

/// Modelo de ONU (catálogo).
model OnuModel {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  brand     OltBrand?
  /// Tipo con que la OLT la conoce (ZTE "type", Huawei equipment ID). Se usa al autorizar.
  oltType   String?
  ethPorts  Int       @default(1)
  potsPorts Int       @default(0)
  wifi      Boolean   @default(false)
  catv      Boolean   @default(false)
  notes     String?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  onus   ONU[]

  @@unique([tenantId, name])
  @@map("onu_models")
}

/// Plan de velocidad de la OLT (perfiles de tráfico usados al autorizar).
model OltSpeedPlan {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  download    Int
  upload      Int
  lineProfile String?
  srvProfile  String?
  vlan        Int?
  notes       String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  onus   ONU[]

  @@unique([tenantId, name])
  @@map("olt_speed_plans")
}

/// Caja NAP (punto de distribución con splitter).
model NapBox {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  coordinates String?
  address     String?
  capacity    Int      @default(8)
  splitter    String?
  oltId       String?
  ponSlot     Int?
  ponPort     Int?
  notes       String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  olt    OLT?   @relation(fields: [oltId], references: [id], onDelete: SetNull)
  onus   ONU[]

  @@unique([tenantId, name])
  @@map("nap_boxes")
}

/// ONU detectada por la OLT sin autorizar (autofind).
model OnuDiscovery {
  id          String   @id @default(cuid())
  oltId       String
  serial      String
  slot        Int
  port        Int
  equipment   String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  /// false cuando deja de aparecer o se autoriza.
  active      Boolean  @default(true)

  olt OLT @relation(fields: [oltId], references: [id], onDelete: Cascade)

  @@unique([oltId, serial])
  @@index([oltId, active])
  @@map("onu_discoveries")
}

/// Evento de la red PON (se abre al detectarlo y se cierra al normalizarse).
model PonEvent {
  id         String       @id @default(cuid())
  tenantId   String
  oltId      String
  onuId      String?
  kind       PonEventKind
  message    String
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  olt    OLT    @relation(fields: [oltId], references: [id], onDelete: Cascade)
  onu    ONU?   @relation(fields: [onuId], references: [id], onDelete: Cascade)

  @@index([tenantId, resolvedAt])
  @@index([oltId, kind, resolvedAt])
  @@map("pon_events")
}

/// Umbrales y frecuencia de lectura de las OLT.
model OltSettings {
  tenantId       String   @id
  /// Señal baja y crítica (dBm).
  lowSignal      Float    @default(-27)
  criticalSignal Float    @default(-29)
  /// Cambio de señal (dB) entre lecturas que genera un evento.
  variationDb    Float    @default(3)
  pollMinutes    Int      @default(5)
  /// Autorizar sola una ONU pre-autorizada cuando la OLT la detecte.
  autoAuthorize  Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("olt_settings")
}
