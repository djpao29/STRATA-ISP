# Copiar a .env.production en el servidor y completar. NO subir a git.

# Base de datos del docker-compose.prod.yml
POSTGRES_USER="wispx"
POSTGRES_PASSWORD=""          # contraseña larga y aleatoria
POSTGRES_DB="wispx"

# URL pública con HTTPS (la de tu dominio)
NEXTAUTH_URL="https://isp.tudominio.com"
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
ENCRYPTION_KEY=""             # mismo comando; guarda una copia segura, no se puede cambiar después

# Alta inicial (docker compose ... run --rm migrate npm run setup). Bórralas después.
SETUP_COMPANY_NAME=""
SETUP_ADMIN_NAME=""
SETUP_ADMIN_EMAIL=""
SETUP_ADMIN_PASSWORD=""

DEFAULT_COUNTRY="EC"
DEFAULT_CURRENCY="USD"
DEFAULT_TIMEZONE="America/Guayaquil"

# ── Monitoreo MikroTik ────────────────────────────────────────
# Con varias instancias de la app, pon "false" en todas menos una.
MONITORING_ENABLED="true"

# ── Facturación por zonas y cortes automáticos ───────────────
# Con varias instancias, pon "false" en todas menos una (además hay un bloqueo en la base).
JOBS_ENABLED="true"
